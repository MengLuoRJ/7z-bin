
{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2023"],

    "module": "Preserve",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",

    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
